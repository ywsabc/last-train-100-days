#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-XshowSettings:properties" ]]; then
  echo "    java.specification.version = ${LASTTRAIN_TEST_JAVA_FEATURE:-21}" >&2
  exit 0
fi

for lasttrain_fake_arg in "$@"; do
  if [[ "$lasttrain_fake_arg" == "--installServer" ]]; then
    printf '#!/usr/bin/env bash\nexit 0\n' > run.sh
    chmod +x run.sh
    mkdir -p libraries/net/neoforged/neoforge/21.1.244
    printf 'NeoForge fixture args\n' \
      > libraries/net/neoforged/neoforge/21.1.244/unix_args.txt
    printf 'NeoForge fixture server\n' \
      > libraries/net/neoforged/neoforge/21.1.244/neoforge-21.1.244-server.jar
    printf '%s\n' "$*" >> "${LASTTRAIN_TEST_LOG:?}"
    exit 0
  fi
done

lasttrain_fake_game=""
lasttrain_fake_side=""
lasttrain_fake_previous=""
for lasttrain_fake_arg in "$@"; do
  case "$lasttrain_fake_previous" in
    --pack-folder)
      lasttrain_fake_game="$lasttrain_fake_arg"
      ;;
    -s)
      lasttrain_fake_side="$lasttrain_fake_arg"
      ;;
  esac
  lasttrain_fake_previous="$lasttrain_fake_arg"
done

[[ "$lasttrain_fake_side" == "client" || "$lasttrain_fake_side" == "server" ]] || {
  echo "fake java expected Packwiz side client or server" >&2
  exit 1
}
[[ -n "$lasttrain_fake_game" ]] || {
  echo "fake java did not receive --pack-folder" >&2
  exit 1
}

mkdir -p "$lasttrain_fake_game/mods"
printf 'packwiz %s fixture\n' "$lasttrain_fake_side" \
  > "$lasttrain_fake_game/mods/from-packwiz-$lasttrain_fake_side.jar"
if [[ "$lasttrain_fake_side" == "server" ]]; then
  for lasttrain_fake_mod in \
    create-1.21.1-6.0.10.jar \
    tongdarailway-1.1.3+mc21.1.jar \
    tacz-neoforge-1.21.1-1.1.8-hotfix-r5.jar \
    create-aeronautics-bundled-1.21.1-1.3.0.jar \
    sable-neoforge-1.21.1-2.0.3.jar \
    sable_pathfinder-1.4.0.jar; do
    printf 'packwiz required server fixture\n' \
      > "$lasttrain_fake_game/mods/$lasttrain_fake_mod"
  done
fi
if [[ "${LASTTRAIN_TEST_FAIL_PACKWIZ_AFTER_WRITE:-0}" == "1" ]]; then
  mkdir -p "$lasttrain_fake_game/config"
  printf 'mutated by failed Packwiz fixture\n' \
    > "$lasttrain_fake_game/config/transaction-sentinel.txt"
  printf 'partial Packwiz fixture\n' \
    > "$lasttrain_fake_game/mods/partial-packwiz.jar"
  printf '%s\n' "$*" >> "${LASTTRAIN_TEST_LOG:?}"
  exit 41
fi
printf '%s\n' "$*" >> "${LASTTRAIN_TEST_LOG:?}"
